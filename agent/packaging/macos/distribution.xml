<?xml version="1.0" encoding="utf-8"?>
<!-- productbuild Distribution for the QCBridge Agent installer.
     @VERSION@ is substituted by build-pkg.sh from agent/Cargo.toml.
     Payload lands at /Applications/QCBridge/{QCBridge Agent.app,
     Uninstall QCBridge Agent.command}; the component is non-relocatable
     so Installer never redirects it onto a dev copy elsewhere. -->
<installer-gui-script minSpecVersion="2">
    <title>QCBridge Agent @VERSION@</title>
    <organization>com.qcbridge</organization>
    <domains enable_localSystem="true"/>
    <options customize="never" require-scripts="true" rootVolumeOnly="true" hostArchitectures="arm64"/>
    <allowed-os-versions>
        <os-version min="13.0"/>
    </allowed-os-versions>
    <welcome file="welcome.txt" mime-type="text/plain"/>
    <choices-outline>
        <line choice="default">
            <line choice="com.qcbridge.agent"/>
        </line>
    </choices-outline>
    <choice id="default"/>
    <choice id="com.qcbridge.agent" visible="false">
        <pkg-ref id="com.qcbridge.agent"/>
    </choice>
    <pkg-ref id="com.qcbridge.agent" version="@VERSION@" onConclusion="none">QCBridge-Agent-core.pkg</pkg-ref>
</installer-gui-script>
